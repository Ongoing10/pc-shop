# Biến môi trường cho profile `dev` (Supabase + MongoDB Atlas dùng chung).
# Copy thành file `.env` (KHÔNG commit) rồi điền giá trị thật, xem README mục "Profile dev".
# Profile `local` không cần file này.

# ---------- Supabase Postgres ----------
# Host của kết nối Direct (IPv6) hoặc Session pooler (IPv4, cổng 5432). KHÔNG dùng cổng 6543.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=

# ---------- Supabase Storage (S3 API) ----------
SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# ---------- MongoDB Atlas ----------
ATLAS_HOST=pcshop.xxxxx.mongodb.net
ATLAS_USER=
ATLAS_PASSWORD=

# ---------- Keycloak ----------
KEYCLOAK_BACKEND_SECRET=backend-secret-local

# ---------- VNPay sandbox (đăng ký tại sandbox.vnpayment.vn, cả profile local) ----------
# Để trống: đơn VNPay/MoMo dùng trang thanh toán giả lập của ordering-service.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ---------- Email (notification-service), cả profile local ----------
# Để trống: gửi vào Mailpit (docker compose, xem http://localhost:8025). Gửi thật, vd Gmail:
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_START_TLS=REQUIRED, MAIL_USERNAME=<gmail>, MAIL_PASSWORD=<mật khẩu ứng dụng>
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=

# ---------- LLM (tùy chọn, khi không dùng Ollama) ----------
GEMINI_API_KEY=
